# Copia a .env y rellena (o enlaza desde la raíz del repo: ln -sf ../.env .env)
# Las claves deben llevar prefijo VITE_ para que Vite las exponga al cliente.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Opcional: URL absoluta del motor de simulación si no usas el proxy de Vite (/api → 8080)
# VITE_SIMULATION_API_URL=http://127.0.0.1:8080
