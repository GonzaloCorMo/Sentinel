# Copiar a .env o exportar en el shell antes de uvicorn
# Broker MQTT (Nivel 1) — arrancar con: docker compose up -d mosquitto
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=hpe/sentinel/telemetry

# Fallback HTTP (Nivel 3) — ingest en el mismo FastAPI por defecto
TELEMETRY_INGEST_URL=http://127.0.0.1:8080/api/telemetry/ingest

# Rutas por OSRM (Docker local en 5000 por defecto; ver docker-compose.yml y ./start.sh).
# Opcional: otra URL, p. ej. OSRM_BASE_URL=https://router.project-osrm.org
OSRM_BASE_URL=http://127.0.0.1:5000
