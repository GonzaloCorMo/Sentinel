{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/verify.sh:*)",
      "Bash(bash scripts/smoke.sh:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(npx vite build:*)",
      "Bash(npx vitepress build:*)",
      "Bash(python -m pyflakes:*)",
      "Bash(python -m compileall:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose restart:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -s http://localhost:*)"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf docker/osrm-data:*)"
    ]
  }
}
