# Copia a .env y rellena los valores. Genera claves frescas con:
#   python3 scripts/generate-supabase-keys.py >> .env

# ── Supabase self-hosted ──────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_40+_CHAR_RANDOM_STRING
SUPABASE_ANON_KEY=REPLACE_WITH_JWT_SIGNED_WITH_ABOVE_SECRET
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_JWT_SIGNED_WITH_ABOVE_SECRET

POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:5173/auth/callback

# ── Google OAuth (opcional) ───────────────────────────────────────────────
GOOGLE_OAUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── LLM (chat: HPE-vLLM externo / embeddings: Ollama local) ──────────────
# Chat se sirve desde el cluster HPE Cray vía endpoints OpenAI-compat.
# Flash = default para todo. Flagship es opt-in por llamada (tier="flagship").
LLM_FLASH_BASE_URL=http://10.10.48.10:8000/v1
LLM_FLAGSHIP_BASE_URL=http://10.10.48.10:8001/v1
LLM_FLASH_MODEL=google/gemma-4-31b-it
LLM_FLAGSHIP_MODEL=Qwen/Qwen3-235B-A22B
LLM_API_KEY=not-needed
# Embeddings siguen en Ollama local (nomic-embed-text → 768D, padded a 1536).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Perfil GPU para Ollama embeddings: gpu-nvidia | gpu-amd | cpu.
# Se pasa a `docker compose --profile <valor> up -d`. No se lee desde aquí.
# Override avanzado para AMD (solo si la auto-detección de Ollama falla).
# HSA_OVERRIDE_GFX_VERSION=11.0.0

# ── OSRM (selector multi-región) ──────────────────────────────────────────
# Cada región corre su propio osrm-routed (ports 5000/5001/5002/5003 host).
# Override del PBF si quieres apuntar a otro extracto. La región activa al
# arrancar se elige con DEFAULT_REGION (aruba|madrid|bogota|mexico).
DEFAULT_REGION=aruba
OSRM_PBF_URL_MADRID=https://download.bbbike.org/osm/bbbike/Madrid/Madrid.osm.pbf
OSRM_PBF_URL_BOGOTA=https://download.bbbike.org/osm/bbbike/Bogota/Bogota.osm.pbf
OSRM_PBF_URL_MEXICO=https://download.bbbike.org/osm/bbbike/MexicoCity/MexicoCity.osm.pbf
OSRM_PBF_URL_ARUBA=https://download.openstreetmap.fr/extracts/central-america/aruba.osm.pbf

# ── Kafka telemetría externa (AsyncAPI Aruba) ─────────────────────────────
KAFKA_TELEMETRY_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=10.10.48.30:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC=aruba.team.tres-dias-de-gracia
KAFKA_TEAM_ID=tres-dias-de-gracia
KAFKA_PUBLISH_INTERVAL_SEC=5

# ── Kafka events consumer (Aruba Pulse, read-only) ────────────────────────
# Reusa KAFKA_BOOTSTRAP_SERVERS / KAFKA_SECURITY_PROTOCOL / KAFKA_SASL_MECHANISM
# / KAFKA_USERNAME / KAFKA_PASSWORD del bloque anterior.
KAFKA_EVENTS_ENABLED=true
KAFKA_EVENTS_TOPIC_EVENTS=aruba.events
KAFKA_EVENTS_TOPIC_WEATHER=aruba.weather
KAFKA_EVENTS_GROUP_ID=tres-dias-de-gracia-events
KAFKA_EVENTS_AUTO_OFFSET_RESET=earliest
