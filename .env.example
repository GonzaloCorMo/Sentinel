# Copia a .env y rellena los valores. Genera claves frescas con:
#   python3 scripts/generate-supabase-keys.py >> .env

# ── Supabase self-hosted ──────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_40+_CHAR_RANDOM_STRING
SUPABASE_ANON_KEY=REPLACE_WITH_JWT_SIGNED_WITH_ABOVE_SECRET
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_JWT_SIGNED_WITH_ABOVE_SECRET

POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:5173/auth/callback

# ── Google OAuth (opcional) ───────────────────────────────────────────────
GOOGLE_OAUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── IA local (Ollama en Docker) ──────────────────────────────────────────
# Chat y embeddings corren en el contenedor `ollama`. El modelo de chat se
# descarga solo en el primer arranque (ollama-init). Para usar otro endpoint
# OpenAI-compatible (vLLM, LM Studio…), cambia las URL y los modelos.
OLLAMA_CHAT_MODEL=qwen2.5:3b
LLM_FLASH_BASE_URL=http://ollama:11434/v1
LLM_FLAGSHIP_BASE_URL=http://ollama:11434/v1
LLM_FLASH_MODEL=qwen2.5:3b
LLM_FLAGSHIP_MODEL=qwen2.5:3b
LLM_API_KEY=not-needed
# Segundos máximos de espera por respuesta del LLM (conexión: 5 s, 1 reintento).
LLM_TIMEOUT_SEC=60
# Embeddings siguen en Ollama local (nomic-embed-text → 768D, padded a 1536).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Perfil GPU para Ollama embeddings: gpu-nvidia | gpu-amd | cpu.
# Se pasa a `docker compose --profile <valor> up -d`. No se lee desde aquí.
# Override avanzado para AMD (solo si la auto-detección de Ollama falla).
# HSA_OVERRIDE_GFX_VERSION=11.0.0

# ── OSRM (selector multi-región) ──────────────────────────────────────────
# Cada región corre su propio osrm-routed (puertos 5000/5001/5002 en el host).
# Override del PBF si quieres apuntar a otro extracto. La región activa al
# arrancar se elige con DEFAULT_REGION (santiago|bogota|mexico).
DEFAULT_REGION=santiago
# Santiago: se descarga Galicia y se recorta a OSRM_BBOX_SANTIAGO (minLon,minLat,maxLon,maxLat).
OSRM_PBF_URL_SANTIAGO=https://download.geofabrik.de/europe/spain/galicia-latest.osm.pbf
OSRM_BBOX_SANTIAGO=-8.70,42.80,-8.40,42.97
OSRM_PBF_URL_BOGOTA=https://download.bbbike.org/osm/bbbike/Bogota/Bogota.osm.pbf
OSRM_PBF_URL_MEXICO=https://download.bbbike.org/osm/bbbike/MexicoCity/MexicoCity.osm.pbf

# ── Fuente de eventos externos ────────────────────────────────────────────
# mock = genera eventos y clima sintéticos en la región activa
# off  = solo ingesta REST (POST /api/events/ingest, POST /api/weather/ingest)
EVENT_SOURCE=mock
MOCK_EVENT_INTERVAL_SEC=25
MOCK_WEATHER_INTERVAL_SEC=10
MOCK_WEATHER_STATIONS=4

# ── Mapa (Stadia Maps, Alidade Smooth) ──
# Vacío en local: Stadia no pide clave desde localhost. En un dominio público,
# registra el dominio en stadiamaps.com o pon aquí la clave.
STADIA_API_KEY=
